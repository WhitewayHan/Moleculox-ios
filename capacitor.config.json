{
  "appId": "com.whitewayhan.moleculox",
  "appName": "Moleculox",
  "webDir": "www",
  "server": {
    "iosScheme": "https",
    "hostname": "localhost"
  },
  "ios": {
    "backgroundColor": "#070b24",
    "contentInset": "never",
    "preferredContentMode": "mobile",
    "allowsLinkPreview": false,
    "scrollEnabled": false
  },
  "plugins": {
    "FirebaseAuthentication": {
      "authDomain": "moleculox-2f4b4.firebaseapp.com",
      "skipNativeAuth": true,
      "providers": [
        "apple.com",
        "google.com"
      ]
    }
  }
}
